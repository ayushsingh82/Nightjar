// Nightjar — private agent-to-agent commerce + reputation
//
// Compact >= 0.23 (compact-runtime 0.16.x). Patterns cross-checked against
// Midnight-Skills templates/private-party-dapp, templates/locker-dapp,
// .agents/skills/compact and .agents/skills/midnight-security.
//
// Privacy boundary
//   private (witness): agent identity secret, running reputation aggregate,
//                      commitment salt
//   public  (ledger) : staked bonds, per-agent reputation commitment, escrow
//                      records (buyer, a COMMITMENT to the seller, amount,
//                      state), arbiter key, slashed total
//   disclosed        : the buyer, bond and escrow amounts, and the single
//                      boolean from proveReputation. A seller\'s identity is
//                      disclosed in exactly one case — a dispute, where the
//                      buyer must name them so a bond can be slashed. Absent
//                      that, a seller\'s job count, volume and success rate are
//                      not derivable from the chain.
//
// Reputation is an INCREMENTAL AGGREGATE, not a replayed ledger.
//
// The first cut folded over a fixed 64-slot job vector on every call. That was
// sound but unshippable: the fold dominated the circuit, and the proving key
// for `proveReputation` came out at 291MB (36MB even at 8 slots — it scales
// linearly with the cap, and the demo badge needs >=50 jobs). No browser is
// fetching that.
//
// Instead each agent keeps a running `[total, successes, volume]` privately and
// the chain holds a commitment to it. `updateReputation` proves one transition
// — open the committed aggregate, add exactly one settled escrow, re-commit —
// and `proveReputation` opens the aggregate and compares it to thresholds.
// Both are O(1), so both are ordinary-sized circuits.
//
// It is also what makes the number honest. A job can only enter the aggregate
// by way of an escrow that actually settled on this contract, at that escrow's
// real amount, with its real outcome, and each escrow counts at most once.
// Nothing is self-reported.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

export enum EscrowState { EMPTY, FUNDED, DELIVERED, RELEASED, DISPUTED, SLASHED }

struct EscrowRecord {
  buyer: Bytes<32>,
  // NOT the seller's agent id — `persistentCommit(sellerAgentId, nonce)`, with
  // the nonce agreed off-chain between the two parties. The seller proves the
  // opening to act on the escrow, so the chain never learns which agent is
  // behind it. Without this, reputation being escrow-bound would make a
  // seller's job count and volume publicly countable, which is the one thing
  // proveReputation exists to prevent.
  sellerCommit: Bytes<32>,
  amount: Uint<64>,
  state: EscrowState
}

// There is no on-chain job type and no ledger capacity: the aggregate is three
// numbers, so an agent's provable history is unbounded and the circuit size
// does not depend on it.

// ---------------------------------------------------------------------------
// Public (ledger) state
// ---------------------------------------------------------------------------

export sealed ledger arbiterPk: Bytes<32>;

// agentId -> staked bond
export ledger bonds: Map<Bytes<32>, Uint<64>>;

// agentId -> persistentCommit(ledgerHash, salt)
export ledger reputationCommitments: Map<Bytes<32>, Bytes<32>>;

// escrowId -> record
export ledger escrows: Map<Bytes<32>, EscrowRecord>;

export ledger escrowCount: Counter;
export ledger slashedTotal: Uint<64>;

// Escrows already folded into someone's reputation. Stops one settlement being
// counted twice; the escrow id is public anyway, so this leaks nothing new.
export ledger countedEscrows: Set<Bytes<32>>;

// escrowId -> the seller id, disclosed by the buyer when raising a dispute.
// Slashing has to name a bond, so accountability costs exactly one identity,
// and only for escrows that actually went wrong. Everything settled amicably
// stays behind its commitment.
export ledger disputedSellers: Map<Bytes<32>, Bytes<32>>;

// ---------------------------------------------------------------------------
// Private (witness) inputs — bodies in contracts/src/witnesses.ts
// ---------------------------------------------------------------------------

witness callerSecret(): Bytes<32>;

// The agent's running aggregate: [total, successes, volume]. Private. The
// chain only ever holds `statsCommit` of it.
witness reputationStats(): [Uint<64>, Uint<64>, Uint<64>];

witness ledgerSalt(): Bytes<32>;

// The opening for one escrow's seller commitment. Agreed off-chain when the job
// is arranged; both parties hold it.
witness escrowNonce(escrowId: Bytes<32>): Bytes<32>;

// ---------------------------------------------------------------------------
// Key derivation — unique domain separator per purpose
// ---------------------------------------------------------------------------

export pure circuit agentIdFrom(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nightjar:agent:v1"), sk]);
}

export pure circuit deriveArbiterPk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nightjar:arbiter:v1"), sk]);
}

// The commitment an agent publishes: hiding and binding over the whole
// aggregate, salted so two agents with identical histories do not collide.
export pure circuit statsCommit(
  total: Uint<64>,
  successes: Uint<64>,
  volume: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentCommit<Vector<4, Bytes<32>>>([
    pad(32, "nightjar:stats:v1"),
    persistentHash<Uint<64>>(total),
    persistentHash<Uint<64>>(successes),
    persistentHash<Uint<64>>(volume)
  ], salt);
}

// Binds an escrow to a seller without naming them.
export pure circuit sellerCommitment(agentId: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(agentId, nonce);
}

// ---------------------------------------------------------------------------
// Constructor
// ---------------------------------------------------------------------------

constructor(arbiterSecret: Bytes<32>) {
  arbiterPk = disclose(deriveArbiterPk(arbiterSecret));
  slashedTotal = 0;
}

// ---------------------------------------------------------------------------
// Bond
// ---------------------------------------------------------------------------

export circuit stakeBond(amount: Uint<64>): [] {
  const id = disclose(agentIdFrom(callerSecret()));
  const current = bonds.member(id) ? bonds.lookup(id) : 0;
  bonds.insert(id, disclose((current + amount) as Uint<64>));
}

export circuit withdrawBond(amount: Uint<64>): [] {
  const amt = disclose(amount);
  const id = disclose(agentIdFrom(callerSecret()));
  assert(bonds.member(id), "no bond staked");
  const current = bonds.lookup(id);
  assert(amt <= current, "bond withdrawal exceeds stake");
  bonds.insert(id, (current - amt) as Uint<64>);
}

// ---------------------------------------------------------------------------
// Reputation
// ---------------------------------------------------------------------------

// Register an agent by committing to a zero aggregate. Required before any
// update, and this is the only circuit that may publish a commitment the caller
// did not derive from a previous one — which is exactly what stops an agent
// from starting life with a fabricated history.
export circuit registerAgent(): [] {
  const id = disclose(agentIdFrom(callerSecret()));
  assert(!reputationCommitments.member(id), "agent already registered");
  reputationCommitments.insert(id, disclose(statsCommit(0, 0, 0, ledgerSalt())));
}

// Fold exactly one settled escrow into the caller's private aggregate.
//
// The job's amount and outcome are read off the escrow record rather than
// supplied by the caller, so an agent cannot invent work, inflate a price, or
// call a failure a success. `countedEscrows` stops the same settlement being
// counted twice. O(1) — no ledger, no fold.
export circuit updateReputation(escrowId: Bytes<32>): [] {
  const eid = disclose(escrowId);
  assert(escrows.member(eid), "unknown escrow");
  const e = escrows.lookup(eid);

  const id = disclose(agentIdFrom(callerSecret()));
  // Same opening proof as markDelivered: the caller is the escrow's seller, and
  // the chain still does not learn that from the escrow record.
  assert(
    sellerCommitment(agentIdFrom(callerSecret()), escrowNonce(eid)) == e.sellerCommit,
    "only the seller can record this job"
  );
  assert(
    e.state == EscrowState.RELEASED || e.state == EscrowState.SLASHED,
    "escrow has not settled"
  );
  assert(!countedEscrows.member(eid), "escrow already counted");
  assert(reputationCommitments.member(id), "agent not registered");

  // Open the committed aggregate. Binding: only the true predecessor opens it.
  const prev = reputationStats();
  const salt = ledgerSalt();
  assert(
    disclose(statsCommit(prev[0], prev[1], prev[2], salt) == reputationCommitments.lookup(id)),
    "aggregate does not match the on-chain commitment"
  );

  // A release is a success worth its escrow amount; a slash is a failure worth
  // nothing. Both count toward the total, so the success rate cannot be gamed
  // by simply never recording the bad ones — the escrow is settled either way
  // and the agent needs the total to move to keep proving anything later.
  const succeeded = e.state == EscrowState.RELEASED;
  const nextTotal     = (prev[0] + 1) as Uint<64>;
  const nextSuccesses = (succeeded ? (prev[1] + 1) : prev[1]) as Uint<64>;
  const nextVolume    = (succeeded ? (prev[2] + e.amount) : prev[2]) as Uint<64>;

  reputationCommitments.insert(
    id,
    disclose(statsCommit(nextTotal, nextSuccesses, nextVolume, salt))
  );
  countedEscrows.insert(eid);
}

// The ZK moment. Open the private aggregate against the on-chain commitment and
// disclose one boolean about it — never the counts, the rate, or the volume.
export circuit proveReputation(
  minJobs: Uint<64>,
  minRateBps: Uint<64>,
  minVolume: Uint<64>
): Boolean {
  assert(disclose(minRateBps) <= 10000, "rate bps out of range");

  const id = disclose(agentIdFrom(callerSecret()));
  assert(reputationCommitments.member(id), "no reputation commitment");

  const stats = reputationStats();
  const total = stats[0];
  const successes = stats[1];
  const volume = stats[2];

  assert(
    disclose(statsCommit(total, successes, volume, ledgerSalt())
             == reputationCommitments.lookup(id)),
    "aggregate does not match the on-chain commitment"
  );

  const okJobs = successes >= minJobs;
  // successes / total >= minRateBps / 10000, in integers.
  const okRate = (successes * 10000) as Uint<64> >= (total * minRateBps) as Uint<64>;
  const okVolume = volume >= minVolume;
  return disclose(okJobs && okRate && okVolume);
}

// ---------------------------------------------------------------------------
// Escrow with slashing
// ---------------------------------------------------------------------------

// The buyer opens against a *commitment* to the seller, built off-chain from
// the seller's agent id and a nonce the two of them share. The escrow id, the
// buyer and the amount stay public; who is being hired does not.
export circuit openEscrow(escrowId: Bytes<32>, sellerCommit: Bytes<32>, amount: Uint<64>): [] {
  const eid = disclose(escrowId);
  const commit = disclose(sellerCommit);
  const amt = disclose(amount);
  assert(!escrows.member(eid), "escrow id already used");
  const buyer = disclose(agentIdFrom(callerSecret()));
  // A buyer hiring themselves would be caught here if the commitment were
  // openable, which it is not — so the check moves to where the seller proves
  // its opening, in markDelivered.
  // `amount` is transferred into escrow by the token layer (out of scope here).
  escrows.insert(eid, EscrowRecord {
    buyer: buyer, sellerCommit: commit, amount: amt, state: EscrowState.FUNDED
  });
  escrowCount.increment(1);
}

export circuit markDelivered(escrowId: Bytes<32>): [] {
  const eid = disclose(escrowId);
  assert(escrows.member(eid), "unknown escrow");
  const e = escrows.lookup(eid);

  // Proves the caller is the seller without saying who the seller is: only the
  // agent whose id opens the commitment can satisfy this.
  const me = agentIdFrom(callerSecret());
  assert(
    sellerCommitment(me, escrowNonce(eid)) == e.sellerCommit,
    "only the seller can deliver"
  );
  assert(disclose(me != e.buyer), "buyer and seller must differ");
  assert(e.state == EscrowState.FUNDED, "escrow not in FUNDED state");
  escrows.insert(eid, EscrowRecord {
    buyer: e.buyer, sellerCommit: e.sellerCommit, amount: e.amount, state: EscrowState.DELIVERED
  });
}

export circuit release(escrowId: Bytes<32>): [] {
  const eid = disclose(escrowId);
  assert(escrows.member(eid), "unknown escrow");
  const e = escrows.lookup(eid);
  assert(disclose(agentIdFrom(callerSecret())) == e.buyer, "only the buyer can release");
  assert(e.state == EscrowState.DELIVERED, "escrow not delivered");
  // funds -> seller (token layer). The settled record is what `updateReputation`
  // later folds into the seller's aggregate.
  escrows.insert(eid, EscrowRecord {
    buyer: e.buyer, sellerCommit: e.sellerCommit, amount: e.amount, state: EscrowState.RELEASED
  });
}

// Raising a dispute is the single place a seller's identity becomes public, and
// the buyer is the one who does it: slashing has to name a bond, so the buyer
// discloses the seller and proves the disclosure opens the escrow's commitment.
// A buyer cannot use this to smear an uninvolved agent — a wrong id fails the
// opening check.
export circuit dispute(escrowId: Bytes<32>, seller: Bytes<32>): [] {
  const eid = disclose(escrowId);
  const sell = disclose(seller);
  assert(escrows.member(eid), "unknown escrow");
  const e = escrows.lookup(eid);
  assert(disclose(agentIdFrom(callerSecret())) == e.buyer, "only the buyer can dispute");
  assert(e.state == EscrowState.FUNDED || e.state == EscrowState.DELIVERED, "not disputable");
  assert(
    sellerCommitment(sell, escrowNonce(eid)) == e.sellerCommit,
    "disclosed seller does not open the escrow commitment"
  );
  disputedSellers.insert(eid, sell);
  escrows.insert(eid, EscrowRecord {
    buyer: e.buyer, sellerCommit: e.sellerCommit, amount: e.amount, state: EscrowState.DISPUTED
  });
}

// Only the arbiter (key fixed at deploy) can resolve. On seller fault the bond
// is slashed by up to the escrow amount.
export circuit resolveDispute(escrowId: Bytes<32>, sellerAtFault: Boolean): [] {
  const eid = disclose(escrowId);
  const fault = disclose(sellerAtFault);
  assert(deriveArbiterPk(callerSecret()) == arbiterPk, "only the arbiter can resolve");
  assert(escrows.member(eid), "unknown escrow");
  const e = escrows.lookup(eid);
  assert(e.state == EscrowState.DISPUTED, "escrow not disputed");

  // The seller was disclosed when the dispute was raised; that is the only way
  // the arbiter knows which bond to slash.
  assert(disputedSellers.member(eid), "no disclosed seller for this dispute");
  const seller = disputedSellers.lookup(eid);

  if (fault) {
    const sellerBond = bonds.member(seller) ? bonds.lookup(seller) : 0;
    const slash = sellerBond < e.amount ? sellerBond : e.amount;
    bonds.insert(seller, (sellerBond - slash) as Uint<64>);
    slashedTotal = (slashedTotal + slash) as Uint<64>;
    escrows.insert(eid, EscrowRecord {
      buyer: e.buyer, sellerCommit: e.sellerCommit, amount: e.amount, state: EscrowState.SLASHED
    });
    // buyer refunded amount + slash by the token layer
  } else {
    escrows.insert(eid, EscrowRecord {
      buyer: e.buyer, sellerCommit: e.sellerCommit, amount: e.amount, state: EscrowState.RELEASED
    });
  }
}
